## SmartBuild Android secrets (DO NOT COMMIT)
## Copy to secrets.properties and fill in real values.
## Gradle also accepts the same names as process environment variables.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

## Optional Auth deep-link overrides (defaults shown)
# SUPABASE_AUTH_SCHEME=smartbuild
# SUPABASE_AUTH_HOST=auth
#
# In the Supabase dashboard → Authentication → URL Configuration, allow:
#   smartbuild://auth
#   smartbuild://auth/reset
# Site URL can stay the app scheme. If you host web/auth-reset.html, add that
# HTTPS origin too so desktop mail clients are not a blank page.
